* Leung NMCNR 三级放大器 - 性能指标自动输出版
.lib "/home/jzhuang/AnalogLLM/AICAS4Analog/scene2/models/sky130.lib.spice" tt

.PARAM
+ CURRENT_0_BIAS=5.0u
+ VDD_VAL=1.8
+ VCM_VAL=0.9
+ CLOAD=10p

* --- 第一级 ---
+ MOSFET_8_2_L_gm1_PMOS=1.93
+ MOSFET_8_2_W_gm1_PMOS=4.0
+ MOSFET_8_2_M_gm1_PMOS=4

* --- 第二级 ---
+ MOSFET_10_1_L_gm2_PMOS=1.44
+ MOSFET_10_1_W_gm2_PMOS=3.2
+ MOSFET_10_1_M_gm2_PMOS=4

* --- 第三级 (微调W到1.7，扶正输出电平以提升带宽) ---
+ MOSFET_23_1_L_gm3_NMOS=1.9
+ MOSFET_23_1_W_gm3_NMOS=0.75 
+ MOSFET_23_1_M_gm3_NMOS=4

* --- 偏置网络 ---
+ MOSFET_0_8_L_BIASCM_PMOS=2.0
+ MOSFET_0_8_W_BIASCM_PMOS=2.3
+ MOSFET_0_8_M_BIASCM_PMOS=4
+ MOSFET_17_7_L_BIASCM_NMOS=0.9
+ MOSFET_17_7_W_BIASCM_NMOS=0.47
+ MOSFET_17_7_M_BIASCM_NMOS=4
+ MOSFET_21_2_L_LOAD2_NMOS=1.5
+ MOSFET_21_2_W_LOAD2_NMOS=2.0
+ MOSFET_21_2_M_LOAD2_NMOS=4

* --- 补偿元件 ---
+ RESISTOR_0=15k
+ CAPACITOR_0=0.4p
+ CAPACITOR_1=0.2p

XX1 0 vdd vinn vinp vout Leung_NMCNR_Pin_3

.subckt Leung_NMCNR_Pin_3 gnda vdda vinn vinp vout
xm11 VOUT net013 vdda vdda sky130_fd_pr__pfet_01v8_lvt l='MOSFET_0_8_L_BIASCM_PMOS' w='MOSFET_0_8_W_BIASCM_PMOS' m='MOSFET_0_8_M_BIASCM_PMOS*10'
xm7 net049 net013 vdda vdda sky130_fd_pr__pfet_01v8_lvt l='MOSFET_0_8_L_BIASCM_PMOS' w='MOSFET_0_8_W_BIASCM_PMOS' m='MOSFET_0_8_M_BIASCM_PMOS'
xm10 net043 net050 vdda vdda sky130_fd_pr__pfet_01v8_lvt l='MOSFET_10_1_L_gm2_PMOS' w='MOSFET_10_1_W_gm2_PMOS' m='MOSFET_10_1_M_gm2_PMOS'
xm6 net050 VOUTN vdda vdda sky130_fd_pr__pfet_01v8_lvt l='MOSFET_0_8_L_BIASCM_PMOS' w='MOSFET_0_8_W_BIASCM_PMOS' m='MOSFET_0_8_M_BIASCM_PMOS'
xm5 VOUTN VOUTN vdda vdda sky130_fd_pr__pfet_01v8_lvt l='MOSFET_0_8_L_BIASCM_PMOS' w='MOSFET_0_8_W_BIASCM_PMOS' m='MOSFET_0_8_M_BIASCM_PMOS'
xm9 net063 vinp net31 net31 sky130_fd_pr__pfet_01v8_lvt l='MOSFET_8_2_L_gm1_PMOS' w='MOSFET_8_2_W_gm1_PMOS' m='MOSFET_8_2_M_gm1_PMOS'
xm8 DM_2 vinn net31 net31 sky130_fd_pr__pfet_01v8_lvt l='MOSFET_8_2_L_gm1_PMOS' w='MOSFET_8_2_W_gm1_PMOS' m='MOSFET_8_2_M_gm1_PMOS'
xm4 net31 net013 vdda vdda sky130_fd_pr__pfet_01v8_lvt l='MOSFET_0_8_L_BIASCM_PMOS' w='MOSFET_0_8_W_BIASCM_PMOS' m='4*MOSFET_0_8_M_BIASCM_PMOS'
xm3 VB3 net013 vdda vdda sky130_fd_pr__pfet_01v8_lvt l='MOSFET_0_8_L_BIASCM_PMOS' w='MOSFET_0_8_W_BIASCM_PMOS' m='MOSFET_0_8_M_BIASCM_PMOS'
xm2 DM_1 net013 vdda vdda sky130_fd_pr__pfet_01v8_lvt l='MOSFET_0_8_L_BIASCM_PMOS' w='MOSFET_0_8_W_BIASCM_PMOS' m='MOSFET_0_8_M_BIASCM_PMOS'
xm1 VB4 net013 vdda vdda sky130_fd_pr__pfet_01v8_lvt l='MOSFET_0_8_L_BIASCM_PMOS' w='MOSFET_0_8_W_BIASCM_PMOS' m='MOSFET_0_8_M_BIASCM_PMOS'
xm0 net013 net013 vdda vdda sky130_fd_pr__pfet_01v8_lvt l='MOSFET_0_8_L_BIASCM_PMOS' w='MOSFET_0_8_W_BIASCM_PMOS' m='MOSFET_0_8_M_BIASCM_PMOS'

xm23 VOUT net049 gnda gnda sky130_fd_pr__nfet_01v8 l='MOSFET_23_1_L_gm3_NMOS' w='MOSFET_23_1_W_gm3_NMOS' m='MOSFET_23_1_M_gm3_NMOS'
xm22 net049 net043 gnda gnda sky130_fd_pr__nfet_01v8 l='MOSFET_21_2_L_LOAD2_NMOS' w='MOSFET_21_2_W_LOAD2_NMOS' m='MOSFET_21_2_M_LOAD2_NMOS'
xm21 net043 net043 gnda gnda sky130_fd_pr__nfet_01v8 l='MOSFET_21_2_L_LOAD2_NMOS' w='MOSFET_21_2_W_LOAD2_NMOS' m='MOSFET_21_2_M_LOAD2_NMOS'
xm19 DM_2 VB4 gnda gnda sky130_fd_pr__nfet_01v8 l='MOSFET_17_7_L_BIASCM_NMOS' w='MOSFET_17_7_W_BIASCM_NMOS' m='MOSFET_17_7_M_BIASCM_NMOS*8'
xm15 VOUTN VB3 DM_2 gnda sky130_fd_pr__nfet_01v8 l='MOSFET_17_7_L_BIASCM_NMOS' w='MOSFET_17_7_W_BIASCM_NMOS' m='MOSFET_17_7_M_BIASCM_NMOS*4'
xm20 net063 VB4 gnda gnda sky130_fd_pr__nfet_01v8 l='MOSFET_17_7_L_BIASCM_NMOS' w='MOSFET_17_7_W_BIASCM_NMOS' m='MOSFET_17_7_M_BIASCM_NMOS*8'
xm16 net050 VB3 net063 gnda sky130_fd_pr__nfet_01v8 l='MOSFET_17_7_L_BIASCM_NMOS' w='MOSFET_17_7_W_BIASCM_NMOS' m='MOSFET_17_7_M_BIASCM_NMOS*4'
xm17 net54 VB4 gnda gnda sky130_fd_pr__nfet_01v8 l='MOSFET_17_7_L_BIASCM_NMOS' w='MOSFET_17_7_W_BIASCM_NMOS' m='MOSFET_17_7_M_BIASCM_NMOS*4'
xm14 VB3 VB3 gnda gnda sky130_fd_pr__nfet_01v8 l='MOSFET_17_7_L_BIASCM_NMOS' w='MOSFET_17_7_W_BIASCM_NMOS' m='MOSFET_17_7_M_BIASCM_NMOS'
xm12 VB4 VB3 net54 gnda sky130_fd_pr__nfet_01v8 l='MOSFET_17_7_L_BIASCM_NMOS' w='MOSFET_17_7_W_BIASCM_NMOS' m='MOSFET_17_7_M_BIASCM_NMOS*4'
xm18 net56 VB4 gnda gnda sky130_fd_pr__nfet_01v8 l='MOSFET_17_7_L_BIASCM_NMOS' w='MOSFET_17_7_W_BIASCM_NMOS' m='MOSFET_17_7_M_BIASCM_NMOS*4'
xm13 DM_1 VB3 net56 gnda sky130_fd_pr__nfet_01v8 l='MOSFET_17_7_L_BIASCM_NMOS' w='MOSFET_17_7_W_BIASCM_NMOS' m='MOSFET_17_7_M_BIASCM_NMOS*4'

I0 net013 gnda 'CURRENT_0_BIAS'
C1 net044 net049 'CAPACITOR_1'
C0 net050 net044 'CAPACITOR_0'
R0 net044 vout 'RESISTOR_0'
.ends

VVDD vdd 0 'VDD_VAL'
VCM_IN vinp 0 'VCM_VAL'
VAC vinn vinp DC 0 AC 1
CL vout 0 'CLOAD'

.control
  set filetype=ascii
  op

  echo " "
  echo "===================================================================================================="
  echo "            LEUNG NMCNR FULL 24-DEVICE OPERATING STATUS REPORT (gm/Id, L & Id)             "
  echo "===================================================================================================="
  echo " DEVICE    | Vgs(V) | Vds(V) | Vmargin(V) | gm/Id (1/V) |  L (um) | Id (uA)"
  echo "----------------------------------------------------------------------------------------------------"

  * --- PMOS 组 (xm0 - xm11) ---
  let vgs0 = abs(@m.xx1.xm0.msky130_fd_pr__pfet_01v8_lvt[vgs])
  let vth0 = abs(@m.xx1.xm0.msky130_fd_pr__pfet_01v8_lvt[vth])
  let vds0 = abs(@m.xx1.xm0.msky130_fd_pr__pfet_01v8_lvt[vds])
  let gm0  = abs(@m.xx1.xm0.msky130_fd_pr__pfet_01v8_lvt[gm])
  let id0  = abs(@m.xx1.xm0.msky130_fd_pr__pfet_01v8_lvt[id])
  let id0_ua = id0 * 1e6
  let l0   = @m.xx1.xm0.msky130_fd_pr__pfet_01v8_lvt[l]
  let vm0  = vds0 - (vgs0 - vth0)
  let gmid0 = gm0 / (id0 + 1e-15)
  echo " PMOS xm0  | $&vgs0 | $&vds0 | $&vm0 | $&gmid0 | $&l0 | $&id0_ua"

  let vgs1 = abs(@m.xx1.xm1.msky130_fd_pr__pfet_01v8_lvt[vgs])
