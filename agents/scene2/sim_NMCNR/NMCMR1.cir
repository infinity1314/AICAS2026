  let vm15 = vd15 - (vg15 - vt15)
  let gmid15 = gm15 / (id15 + 1e-15)
  echo " NMOS xm15 | $&vg15 | $&vd15 | $&vm15 | $&gmid15 | $&l15 | $&id15_ua"

